# ManagerBot's own settings. What every bot shares -- the database, the family
# bus, credit, logging and the running-cost dials -- is in ../shared/.env
# (template: ../shared/.env.example). Anything set here wins over that file.

# --- ManagerBot's own identity ---
MBOT_TOKEN=123456:ABC-your-managerbot-token
MBOT_USERNAME=YourManagerBotUsername

# REQUIRED. Your numeric Telegram user id(s), comma-separated. ManagerBot is
# owner-only by definition and refuses to start with this empty -- unlike the
# other four bots, where an empty admin list just disables the admin commands.
# Get your id from e.g. @userinfobot.
MBOT_ADMIN_ID=

# --- this bot's own schema ---
# ManagerBot's own schema inside that database.
DB_SCHEMA=manager_bot

# --- who ManagerBot watches ---
# id:DisplayName:schema, comma-separated. The ids must match each bot's own
# BOT_NAME. Only needed if you add or rename a bot -- the built-in default is
# exactly the line below.
# FAMILY_REGISTRY=stickerbot:StickerBot:sticker_bot,convertbot:ConvertBot:convert_bot,downloaderbot:DownloaderBot:downloader_bot,anonbot:AnonBot:anon_bot

# --- monitoring tuning (all optional) ---
# A bot counts as down once its heartbeat is this stale, in seconds.
# Heartbeats are sent every 30s, so the default of 120 is four missed beats.
MBOT_DOWN_AFTER_SECONDS=120
# How long a queued command waits for its target before ManagerBot reports
# that bot as unreachable.
MBOT_COMMAND_TIMEOUT_SECONDS=90
# "HH:MM" UTC for a once-a-day summary DM. Empty (the default) means none --
# crashes and down/up transitions already arrive on their own.
MBOT_DIGEST_UTC=
# Seconds ManagerBot waits after starting before sending the startup roll-call
# -- one message saying which of the four came up with it. The delay is what
# makes it one message instead of five; the other four write their first
# heartbeat the moment they start, so a few seconds is enough. 0 reports
# immediately.
MBOT_ROLLCALL_SECONDS=5
# A bot whose heartbeat is younger than this at roll-call time is reported as
# "just started" rather than "already up". Wording only.
MBOT_ROLLCALL_FRESH_SECONDS=120

# --- the nightly problem report ---
# Everything the four bots showed anybody in the last day, in one message:
# urgent problems listed with their incidents, faults grouped by bot and code,
# and what the bots handled correctly by kind -- people shown how to use a
# bot, limits reached, old buttons, the other person's choice, an update
# pause. Then any feedback the owner asked to receive here (/feedback).
# "HH:MM" in UTC, or empty for none.
#
# The default is 22:00 where the owner is (it was midnight until 2.1.0).
# Korea has not observed daylight saving since 1988, so KST is UTC+9 all year
# and 13:00 UTC is 22:00 in Suwon on every date -- no timezone database, and
# no twice-yearly hour where it arrives at nine.
#
# Deliberately NOT the release window, which is 04:00 Asia/Tashkent (23:00
# UTC) and is chosen for when the USERS are asleep. These two have no reason
# to be the same time.
# MBOT_NIGHTLY_UTC=13:00
#
# How far back it looks, and what /errors quotes the recorded counts for.
# MBOT_NIGHTLY_HOURS=24
#
# The same knobs the four public bots have, because ManagerBot records its own
# problems on the same rail. See any public bot's .env.example for what they
# do.
# PROBLEM_DETAIL_RETENTION_DAYS=30
# PROBLEM_RETENTION_DAYS=180
