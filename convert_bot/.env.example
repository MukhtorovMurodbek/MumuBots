# ConvertBot's own settings. What every bot shares -- the database, the family
# bus, credit, logging and the running-cost dials -- is in ../shared/.env
# (template: ../shared/.env.example). Anything set here wins over that file.

# --- this bot's own identity ---
CBOT_TOKEN=123456:ABC-your-convertbot-token
CBOT_USERNAME=YourConvertBotUsername

# Your own numeric Telegram user id(s) (not username), comma-separated if
# you use more than one account -- gates the owner-only /stars,
# /messageas, /dbdump, and /status admin commands. Leave blank to disable
# all four. Get your id from e.g. @userinfobot.
CBOT_ADMIN_ID=

# --- this bot's own schema ---
# This bot's own schema inside that shared database. The whole family shares
# one database with one schema per bot, so the four bots' identically-named
# tables (user_settings, star_transactions, ...) never collide. Leave it
# unset only if you are running this bot against a database of its own.
DB_SCHEMA=convert_bot

# --- this bot's long-form policies ---
# PRIVACY.md and TERMS.md in this folder are the long forms; pushed to
# MumuBots with the rest of the repository, they have a URL. Paste them here,
# and put the privacy one into @BotFather as well
# (/mybots -> this bot -> Bot Settings -> Privacy Policy). Until 2.0.0 they
# were in this bot's own repository, retired with the move to MumuBots.
PRIVACY_URL=https://github.com/MukhtorovMurodbek/MumuBots/blob/main/convert_bot/PRIVACY.md
TERMS_URL=https://github.com/MukhtorovMurodbek/MumuBots/blob/main/convert_bot/TERMS.md

# --- optional: files over 20 MB (big_files.py) ---
# The cloud Bot API lets a bot download 20 MB and send back 50. With these two
# set, anything bigger goes over MTProto instead -- in private chats, up to
# CONVERT_MAX_FILE_MB. Both come from my.telegram.org -> API development
# tools. Left empty -- here and as TELEGRAM_API_ID in shared/.env -- the bot
# takes 20 MB at most, as before.
CBOT_API_ID=
CBOT_API_HASH=

# --- optional: local Bot API server (https://github.com/tdlib/telegram-bot-api) ---
# The other way to lift the same limits. Not needed with the two above.
LOCAL_BOT_API_URL=
LOCAL_BOT_API_MODE=true
# Largest upload, in MB: 2000 -- Telegram's own -- by default when either
# route above is set, and never more than 20 without one. Lower it, never
# higher: see "limits" in convert_utils.py for what keeps a big file safe.
CONVERT_MAX_FILE_MB=

# --- optional: let /donate accept USD as well as Telegram Stars ---
#
# READ THIS BEFORE SETTING IT. Leaving it blank is the recommended state and
# is why /donate currently shows one column of buttons rather than two: the
# fiat column is drawn only for currencies that have a provider token, so an
# empty value here is not a bug, it is the feature working.
#
# Stars need no provider, no merchant account, no KYC and no country
# support, and they are the rail Telegram itself expects for anything
# digital -- a bot selling a digital good or taking a voluntary contribution
# is Stars territory, and provider payments are aimed at physical goods and
# real-world services. Stars also work for every user in every country,
# which a card provider does not.
#
# What Stars cost you is the way out: Stars -> TON via Fragment (with a
# holding period) -> sell. That is several hops, and it is the honest reason
# to want a card provider instead.
#
# If you do want one: @BotFather -> /mypayments -> Connect, pick a provider
# that supports payouts to YOUR country -- that is the constraint that
# decides this, not the bot -- and paste the token it gives you here. Check
# the provider's own cut against the tier amounts in shared_features.py's
# FIAT_CURRENCIES first: at the $1 tier a percentage-plus-fixed fee can take
# most of the donation, which is why that column starts at $1 and not at the
# Stars column's equivalent of $0.30.
#
# Nothing changes until this is set. With it set, /donate grows a second
# column and `/donate 5 usd` starts working.
PAYMENT_PROVIDER_TOKEN_USD=

# --- conversions ---
# An upload waits on disk, not in memory, between "here is my file" and
# "convert it to X". Anything nobody comes back for within the TTL is
# deleted, including files orphaned by a restart.
# CONVERT_UPLOAD_DIR=
# CONVERT_PENDING_TTL_SECONDS=900
# FFMPEG_THREADS=2
# FFMPEG_TIMEOUT_SECONDS=600
#
# What a conversion may cost in WORK rather than in bytes. The price comes
# from the file size, and size stopped being a good proxy the moment this bot
# learned to read documents: a 900 KB PDF can be four hundred pages, and a few
# hundred kilobytes of GIF can be thousands of frames. These are the ceilings
# that cap the job instead of charging for it, and a job over one is refused
# before an invoice is sent rather than after.
# CONVERT_MAX_PAGES=200
# CONVERT_MAX_FRAMES=1200
# CONVERT_MAX_ROWS=100000
# CONVERT_MAX_CELLS=2000000
# The largest one page may be when it is drawn as a picture, in megapixels: a
# page's size is written into the file, so a few hundred bytes can ask for a
# gigabyte. A YAML file that repeats itself through anchors is held to
# CONVERT_MAX_CELLS values, for the same reason.
# CONVERT_MAX_PAGE_MEGAPIXELS=100
#
# How many files one conversion may take. Only pictures arrive in sets --
# several at once become a single PDF, or a zip of individual results.
# Telegram caps an album at 10; a longer run of separate messages is collected
# the same way and stops here.
# CONVERT_MAX_BATCH=20
# How long to wait for the rest of an album after its first file lands. An
# album arrives as separate messages milliseconds apart, and this is what
# turns them back into one conversion instead of one menu each.
# CONVERT_BATCH_WAIT_SECONDS=2
#
# The resolution a document page is rendered at when it becomes a picture.
# 150 dpi is readable on a phone and about a quarter of the pixels of 300.
# CONVERT_PAGE_DPI=150

# --- the conversion queue (jobs.py) ---
# How many conversions run at once across the whole bot, and how long one may
# run before it is stopped and its credit given back. A free conversion (under
# 1 MB) gets the shorter limit.
# CONVERT_MAX_CONCURRENT=1
# CONVERT_TIME_LIMIT_SECONDS=600
# CONVERT_FREE_TIME_LIMIT_SECONDS=60
# How many conversions one person may have waiting or running.
# CONVERT_MAX_QUEUED_PER_USER=5
# Disk for kept files: one person's share (by default the largest file twice
# over -- it and what it becomes -- or 2000 MB if that is more, capped at the
# largest album, CONVERT_MAX_BATCH x CONVERT_MAX_FILE_MB, plus 50),
# everybody's together, and the free space that must remain.
# CONVERT_USER_STORAGE_MB=
# CONVERT_STORAGE_MB=
# CONVERT_MIN_FREE_MB=300
# The largest picture converted at all, in megapixels.
# CONVERT_MAX_MEGAPIXELS=210
# A hard memory cap on the conversion subprocess, in MB. 0 leaves it to the
# container.
# CONVERT_WORKER_MAX_MEMORY_MB=0
