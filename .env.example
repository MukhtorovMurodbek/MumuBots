# Copy to .env for local runs. On Railway, set these as service variables instead.
# Values in <angle brackets> must be replaced: main.py refuses to start while any are left.
#
# Any setting can be given to one bot only by prefixing it with that bot's prefix:
# SBOT_ (sticker), CBOT_ (convert), DBOT_ (downloader), ABOT_ (anon), MBOT_ (manager).
# e.g. CBOT_FFMPEG_THREADS=4 applies to ConvertBot alone.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Supabase: Project Settings -> Database -> Session pooler (port 5432).
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
# Numeric Telegram user id(s) of the operator, comma-separated (@userinfobot shows yours).
ADMIN_ID=<your-telegram-user-id>

# ── Bots: a bot without a token is skipped ──────────────────────────────────
SBOT_TOKEN=<token-from-BotFather>
SBOT_USERNAME=<sticker-bot-username>

CBOT_TOKEN=<token-from-BotFather>
CBOT_USERNAME=<convert-bot-username>

DBOT_TOKEN=<token-from-BotFather>
DBOT_USERNAME=<downloader-bot-username>

ABOT_TOKEN=<token-from-BotFather>
ABOT_USERNAME=<anon-bot-username>

MBOT_TOKEN=<token-from-BotFather>
MBOT_USERNAME=<manager-bot-username>

# ── Optional ────────────────────────────────────────────────────────────────
# MTProto (my.telegram.org): lets Convert/Downloader handle files up to 2000 MB instead of 50 MB.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# The data key that seals personal data (docs/data-protection.md): a file on a volume (default
# /run/secrets/mumu_data_key). On Railway never a variable -- not DATA_KEY, not DATA_KEY_INIT:
# Railway keeps every deployment's variables. DATA_KEY works for local runs only.
# DATA_KEY_FILE=
# The public half of your offline key (age1..., from scripts/backup_key.py). The reserve copies,
# the nightly Telegram copy and the erasure notes are encrypted to it; only the private half, in
# your password manager, opens them. Reserve copies on the volume need it.
# BACKUP_PUBLIC_KEY=

# Reserve copies on a Railway volume (docs/reserve-copies.md): the folder, and the shortest gap
# in seconds between two copies of what changed. Without it only the nightly Telegram copy is made.
# RESERVE_DIR=/data/reserve
# MBOT_RESERVE_MIN_SECONDS=120

# Which bots this process runs (default: all with a token): sticker, convert, downloader, anon, manager.
# BOTS=sticker,anon
# How they are split into processes: one (default), separate, or groups like "manager;convert".
# MUMU_PROCESSES=one

# Where users and the operator are pointed for terms, privacy and contact.
# Defaults to this repository's LEGAL.md; a fork that runs its own bots should point at its own.
# LEGAL_URL=https://github.com/<you>/<repo>/blob/main/LEGAL.md
# OPERATOR_CONTACT=<email>
# FAMILY_REPORTS_TO=<telegram-user-id-for-reports>

# Logging and process tuning
# LOG_TO_FILES=0
# UNIFIED_STATUS_MINUTES=30
# Seconds a stop signal waits for the bots (each first waits up to DEPLOY_SIGTERM_WAIT_SECONDS for its
# work in progress, then tells anyone still interrupted). Keep it under the host's draining window
# (railway.json: 120).
# UNIFIED_DRAIN_SECONDS=90
# WORKER_THREADS_PER_BOT=16
# GC_GEN0_THRESHOLD=5000

# Payments (Telegram Stars; fiat only with a provider token)
# FIAT_DONATIONS=off
# SBOT_PAYMENT_PROVIDER_TOKEN_USD=
# FAMILY_TOPUP_MULTIPLIER=2
# FAMILY_TOPUP_LADDER=500:3,500:2
# FAMILY_BONUS_EXPIRY_DAYS=90

# Problem reports and usage alarms
# PROBLEM_FLUSH_SECONDS=20
# PROBLEM_ALERT_COOLDOWN_SECONDS=900
# PROBLEM_RETENTION_DAYS=180
# FEEDBACK_RETENTION_DAYS=30
# FEEDBACK_PER_DAY=5
# USAGE_SAMPLE_MINUTES=15
# USAGE_MEMORY_WARN_RATIO=0.85
# The details button comes with crashes and the like (problems.WANTS_DETAILS), and with any other fault
# from its PROBLEM_DETAILS_AFTER-th time in one chat within PROBLEM_DETAILS_WINDOW_SECONDS.
# PROBLEM_DETAILS_AFTER=3
# PROBLEM_DETAILS_WINDOW_SECONDS=3600
# Days the anonymous daily counts of what was done (family.daily_stats, ManagerBot's /stats) are kept.
# FAMILY_STATS_RETENTION_DAYS=400

# How many updates one bot holds in memory at once (queued, waiting their person's turn, or being
# handled); past that, polling waits and Telegram keeps the rest. Bounds a crowd's memory: 2,000
# people at once took a process from 94 to 399 MB without it, 170 MB with 256. 0 = no bound.
# UPDATES_IN_MEMORY_MAX=256
# PER_USER_WAITING_MAX=24

# Flood control (0 = off; the operator is always exempt)
# FLOOD_UPDATES_PER_MINUTE=40
# FLOOD_REMIND_SECONDS=60

# Database pool
# DB_POOL_MIN=1
# DB_POOL_MAX=3
# DB_POOL_TIMEOUT=15

# Safe redeploys: the old and new copy hand over in-flight work through the database.
# DEPLOY_SAFETY=on
# DEPLOY_LEASE_WAIT_SECONDS=240
# How long a copy that died without handing the poll lease back keeps it (renewed every third of it).
# DEPLOY_LEASE_TTL_SECONDS=30
# How long a stop signal from the host waits for work in progress before it goes ahead.
# DEPLOY_SIGTERM_WAIT_SECONDS=60
# ManagerBot's /shutdown and /restart stop a service only when nobody is using it: nothing slow in
# progress, nobody but the owners active in the last SOFTSTOP_QUIET_MINUTES, and no conversation
# part-way through with a step in the last SOFTSTOP_CONVERSATION_MINUTES.
# SOFTSTOP_QUIET_MINUTES=5
# SOFTSTOP_CONVERSATION_MINUTES=20

# StickerBot / video encoding
# STICKER_ENCODE_ATTEMPTS=4
# The fastest speed-up offered for a clip over 3 seconds (a longer one is offered trimming instead).
# STICKER_MAX_SPEED=4
# FFMPEG_THREADS=2
# FFMPEG_TIMEOUT_SECONDS=600

# ConvertBot limits
# CONVERT_MAX_CONCURRENT=1
# CONVERT_TIME_LIMIT_SECONDS=600
# CONVERT_FREE_TIME_LIMIT_SECONDS=60
# CONVERT_MAX_BATCH=20
# CONVERT_MAX_PAGES=200
# CONVERT_MIN_FREE_MB=300

# DownloaderBot limits, cookies and proxies (per platform: see bots/downloader_bot/video.py)
# DBOT_DOWNLOADS_PER_HOUR=12
# DBOT_DOWNLOADS_PER_DAY=40
# DBOT_MAX_DOWNLOAD_MB=48
# DBOT_MAX_DURATION_SECONDS=10800
# DBOT_COOKIES_FILE=
# DBOT_PROXY=
# The relays for the one site whose links the bot takes without advertising it (resolvers.py):
# the site refuses a server's address, so the file comes through somebody else's. Yours first;
# the key goes to the first cobalt instance only. The directory finds more Invidious instances
# ("0": only the ones named here). The timeouts are for the whole route, file included.
# DBOT_COBALT_INSTANCES=https://api.cobalt.liubquanti.click,https://cobaltapi.cjs.nz,https://dwnld.nichind.dev
# DBOT_COBALT_API_KEY=
# DBOT_COBALT_QUALITY=720
# DBOT_COBALT_INSTANCE_TIMEOUT=15
# DBOT_COBALT_TIMEOUT=240
# DBOT_INVIDIOUS_INSTANCES=https://yt.chocolatemoo53.com
# DBOT_INVIDIOUS_DIRECTORY=https://api.invidious.io/instances.json
# DBOT_INVIDIOUS_INSTANCE_TIMEOUT=15
# DBOT_INVIDIOUS_TIMEOUT=240
# The kept last delivery (delivery_cache.py): how many per person, for how long. 0 seconds: none.
# DBOT_CACHE_PER_USER=1
# DBOT_CACHE_SECONDS=600
# The quality picker: how long reading a video's versions may take before it just downloads.
# DBOT_QUALITY_LOOKUP_TIMEOUT=25
# Group chats: the bot sees the links posted there only as an admin of the group, or with
# privacy mode turned off for it in @BotFather (/setprivacy -> Disable).

# AnonBot
# ABOT_MSGS_PER_MINUTE=20
# ABOT_NEW_CONV_COOLDOWN_SEC=30
# RELAY_RETENTION_DAYS=180

# ManagerBot schedules (UTC)
# MBOT_DIGEST_UTC=09:00
# MBOT_NIGHTLY_UTC=13:00
