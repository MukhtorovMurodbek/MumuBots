# =============================================================================
#  MumuCombined -- every setting any of the five bots reads, in one file
# =============================================================================
#
#  Copy to .env for a local run, or paste the lines you set into the host's
#  variables (Railway: Variables -> Raw Editor).
#
#  [REQUIRED]           nothing runs without it
#  [REQUIRED for X]     bot X is left out without it; the other bots still run
#  [optional]           works without it
#
#  Every required line below is EMPTY until filled in -- an example is only
#  ever in the comment above it. At startup the settings are checked before
#  any bot loads, and a missing or example value is named in the log.
#
#  Optional lines start with "# " and show the default, or an example where
#  it says "e.g.". Remove the "# " to change one. An empty value means the same
#  as leaving the line out.
#
#  Any setting can be given to ONE bot by adding that bot's prefix:
#      SBOT_ StickerBot   CBOT_ ConvertBot   DBOT_ DownloaderBot
#      ABOT_ AnonBot      MBOT_ ManagerBot
#  e.g. DBOT_POLL_TIMEOUT=50 changes DownloaderBot only. Without a prefix a
#  setting applies to every bot that reads it.
#
#  At least one bot's token has to be set, or there is nothing to run and the
#  process exits.


# -----------------------------------------------------------------------------
#  The database
# -----------------------------------------------------------------------------

# [REQUIRED] One Postgres for all five bots. Each bot keeps its tables in a
# schema of its own (sticker_bot, convert_bot, ...); that is set
# automatically, so DB_SCHEMA is not a setting here.
# Supabase: Project Settings -> Database -> Connect -> the SESSION pooler
# string (port 5432, not 6543), which looks like
#   postgresql://postgres.abcdefghij:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# with your own project id, password and region in it. Percent-encode
# @ : / ? # and spaces in the password (@ becomes %40).
DATABASE_URL=


# -----------------------------------------------------------------------------
#  The owner
# -----------------------------------------------------------------------------

# [REQUIRED for ManagerBot] Numeric Telegram user id of the owner (get it from
# @userinfobot); comma-separated for more than one account. One line for all
# five bots -- it stands in for SBOT_ADMIN_ID, CBOT_ADMIN_ID, DBOT_ADMIN_ID,
# ABOT_ADMIN_ID and MBOT_ADMIN_ID, any of which still wins for its own bot.
# ManagerBot answers only this id and does not start without it. For the other
# four it is optional: without it their owner-only commands are switched off.
ADMIN_ID=


# -----------------------------------------------------------------------------
#  The bots -- token and username from @BotFather, username without the @
# -----------------------------------------------------------------------------

# [REQUIRED for StickerBot]
SBOT_TOKEN=
SBOT_USERNAME=

# [REQUIRED for ConvertBot]
CBOT_TOKEN=
CBOT_USERNAME=

# [REQUIRED for DownloaderBot]
DBOT_TOKEN=
DBOT_USERNAME=

# [REQUIRED for AnonBot]
ABOT_TOKEN=
ABOT_USERNAME=

# [REQUIRED for ManagerBot] (and ADMIN_ID above)
MBOT_TOKEN=
MBOT_USERNAME=


# -----------------------------------------------------------------------------
#  What the public bots show people
# -----------------------------------------------------------------------------

# [optional] Named in /privacy and /terms as who to contact.
# OPERATOR_CONTACT=mukhtorovmurodbek@gmail.com

# [optional] Where LEGAL.md is published. Each public bot's /privacy and /terms
# link to their own sections of it, as <LEGAL_URL>#convertbot-privacy.
# SBOT_PRIVACY_URL / SBOT_TERMS_URL (and so on) still win for their own bot.
# LEGAL_URL=https://github.com/MukhtorovMurodbek/MumuCombined/blob/main/LEGAL.md

# [optional] How the public bots point at each other, id:Name:username.
# Written automatically from the four usernames above; set it only to
# override. e.g.
# SIBLING_BOTS=stickerbot:StickerBot:name,convertbot:ConvertBot:name,downloaderbot:DownloaderBot:name,anonbot:AnonBot:name


# -----------------------------------------------------------------------------
#  Telegram
# -----------------------------------------------------------------------------

# [optional] Files past the Bot API's limits, both ways, over MTProto
# (core/big_files.py), in private chats: ConvertBot's conversions up to 2000
# MB, and DownloaderBot's paid large files. The Telegram *app's* credentials,
# not a bot's -- my.telegram.org -> API development tools -- so one pair
# serves both. Without them ConvertBot takes 20 MB at most and DownloaderBot
# 48. CBOT_API_ID / DBOT_API_ID (and _HASH) still win for their own bot.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# [optional] A self-hosted Bot API server (github.com/tdlib/telegram-bot-api)
# lifts the 20 MB download / 50 MB upload limits. StickerBot and ConvertBot.
# Default: Telegram's own. e.g.
# LOCAL_BOT_API_URL=http://localhost:8081
# LOCAL_BOT_API_MODE=true

# [optional] Seconds each long poll waits for updates. Longer means fewer
# requests for the same latency.
# POLL_TIMEOUT=30


# -----------------------------------------------------------------------------
#  Running them in one process
# -----------------------------------------------------------------------------

# [optional] Which bots to run: any of sticker, convert, downloader, anon,
# manager. Default: every bot that has a token.
# BOTS=sticker,anon

# [optional] Threads shared by all the bots for blocking work (database calls,
# image encoding, downloads). Started only when needed.
# WORKER_THREADS=8

# [optional] Minutes between the one-line status report in the log; 0 = off.
# UNIFIED_STATUS_MINUTES=30

# [optional] Seconds a shutdown waits for the bots to tell anyone whose work
# was interrupted.
# UNIFIED_DRAIN_SECONDS=30

# [optional] Seconds to wait at startup for a database that is not answering,
# before giving up. (One that cannot exist, or refuses the password, is
# reported at once.)
# UNIFIED_DB_WAIT_SECONDS=120

# [optional] Rotating log files next to each bot as well as stdout. Default:
# on locally, off on Railway and in the Docker image.
# LOG_TO_FILES=0

# [optional] Python's garbage-collector threshold for new objects.
# GC_GEN0_THRESHOLD=5000


# -----------------------------------------------------------------------------
#  Money -- donations, card payments, credit
# -----------------------------------------------------------------------------

# [optional] Card payments in /donate, frozen on purpose. Turning them on takes
# BOTH FIAT_DONATIONS=on AND a provider token -- and a provider token from
# @BotFather belongs to one bot, so each bot takes its own, prefixed.
# FIAT_DONATIONS=off
# SBOT_PAYMENT_PROVIDER_TOKEN_USD=
# CBOT_PAYMENT_PROVIDER_TOKEN_USD=
# DBOT_PAYMENT_PROVIDER_TOKEN_USD=
# ABOT_PAYMENT_PROVIDER_TOKEN_USD=

# [optional] Pin the donation nudge in the chat instead of leaving it in the
# scroll.
# DONATION_PIN=off

# [optional] What a Stars payment buys, in credit. TERMS.md promises these
# defaults -- change them only together with the terms.
# FAMILY_TOPUP_MULTIPLIER=2
# FAMILY_TOPUP_LADDER=500:3,500:2
# FAMILY_BONUS_EXPIRY_DAYS=90
#
# What a job is sold for (pricing.py): its cost plus a markup that is the cost
# itself up to FAMILY_PRICE_KNEE ⚡, and grows as cost^FAMILY_PRICE_POWER after
# it; never under FAMILY_PRICE_MINIMUM. The cost is valued at the deepest
# rate above, so changing the ladder changes the prices with it.
# tests/test_pricing.py holds any values to covering the machine.
# FAMILY_PRICE_OVERHEAD=0.5
# FAMILY_PRICE_KNEE=5
# FAMILY_PRICE_POWER=0.8
# FAMILY_PRICE_MINIMUM=3
# FAMILY_USD_PER_STAR=0.013

# [optional] 1 credits Stars payments WITHOUT CHARGING for them. For a test bot
# only -- NEVER on bots real people pay.
# FAMILY_STARS_SANDBOX=


# -----------------------------------------------------------------------------
#  Problems and reports
# -----------------------------------------------------------------------------

# [optional] The Telegram user id problem reports are sent to.
# FAMILY_REPORTS_TO=8796896653
# [optional] off hides the "Report the issue" button; the error codes stay.
# FAMILY_REPORT_BUTTONS=on
# [optional] How problems are written, alerted on and kept.
# PROBLEM_FLUSH_SECONDS=20
# PROBLEM_ALERT_COOLDOWN_SECONDS=900
# PROBLEM_BURST_COUNT=15
# PROBLEM_BURST_WINDOW_SECONDS=3600
# PROBLEM_DETAIL_RETENTION_DAYS=30
# PROBLEM_RETENTION_DAYS=180
# [optional] Days /feedback is kept, and how many one person may send a day.
# FEEDBACK_RETENTION_DAYS=30
# FEEDBACK_PER_DAY=5
# [optional] Network errors in a row before the owner is told.
# NETWORK_ALERT_AFTER=20


# -----------------------------------------------------------------------------
#  Usage monitoring (what ManagerBot's /usage and /idle read)
# -----------------------------------------------------------------------------

# [optional]
# USAGE_SAMPLE_MINUTES=15
# USAGE_MEMORY_WARN_RATIO=0.85
# USAGE_SPIKE_FACTOR=6
# USAGE_SPIKE_FLOOR=60
# USAGE_MONTHLY_USERS_WARN=400
# USAGE_FAILURE_WARN_RATIO=0.5
# USAGE_FAILURE_FLOOR=4
# SLEEP_AFTER_SECONDS=300


# -----------------------------------------------------------------------------
#  Per-person limits and memory
# -----------------------------------------------------------------------------

# [optional] Updates one person may send a minute before being slowed down;
# 0 = off. The owner is always exempt.
# FLOOD_UPDATES_PER_MINUTE=40
# FLOOD_REMIND_SECONDS=60
# [optional] Hours before an idle person's in-memory state is dropped.
# USER_DATA_TTL_HOURS=12


# -----------------------------------------------------------------------------
#  Database connections and retention
# -----------------------------------------------------------------------------

# [optional] Each bot's connection pool.
# DB_POOL_MIN=1
# DB_POOL_MAX=3
# DB_POOL_MAX_IDLE=120
# DB_POOL_TIMEOUT=15
# DB_POOL_CHECK_AFTER_IDLE=45
# [optional] How often activity is written, and how long it is kept.
# ACTIVITY_FLUSH_SECONDS=60
# ACTIVITY_RETENTION_DAYS=90


# -----------------------------------------------------------------------------
#  The family bus (heartbeats, ManagerBot's remote commands)
# -----------------------------------------------------------------------------

# [optional] off runs the bots without heartbeats or ManagerBot's reach.
# FAMILY_BUS=on
# FAMILY_HEARTBEAT_SECONDS=30
# FAMILY_BUS_POLL_ACTIVE_SECONDS=1
# FAMILY_BUS_POLL_IDLE_SECONDS=10
# FAMILY_BUS_ACTIVE_WINDOW_SECONDS=20
# FAMILY_MAX_COMMANDS_PER_PASS=10
# FAMILY_HOUSEKEEPING_SECONDS=21600
# FAMILY_COMMAND_RETENTION_HOURS=24
# FAMILY_EVENT_RETENTION_DAYS=30
# FAMILY_USAGE_RETENTION_DAYS=45
# [optional] Update announcements: who counts as active, and the send rate.
# FAMILY_BROADCAST_ACTIVE_DAYS=7
# FAMILY_BROADCAST_PER_SECOND=20


# -----------------------------------------------------------------------------
#  Deploys (one poller per token, state that survives a restart)
# -----------------------------------------------------------------------------

# [optional] off disables all of it.
# DEPLOY_SAFETY=on
# DEPLOY_LEASE_WAIT_SECONDS=240
# How long a copy that died without handing the poll lease back keeps it (renewed every third of it).
# DEPLOY_LEASE_TTL_SECONDS=30
# DEPLOY_PERSIST_SECONDS=180
# DEPLOY_STATE_TTL_HOURS=12
# DEPLOY_MAINTENANCE_MINUTES=10


# -----------------------------------------------------------------------------
#  StickerBot
# -----------------------------------------------------------------------------

# [optional] Video-sticker encoding.
# STICKER_ENCODE_ATTEMPTS=4
# FFMPEG_THREADS=2
# [optional] ffmpeg time limit: StickerBot's default is 120, ConvertBot's 600.
# ConvertBot's conversions read only the unprefixed name, which StickerBot
# also reads unless SBOT_FFMPEG_TIMEOUT_SECONDS is set for it.
# SBOT_FFMPEG_TIMEOUT_SECONDS=120
# FFMPEG_TIMEOUT_SECONDS=600


# -----------------------------------------------------------------------------
#  ConvertBot
# -----------------------------------------------------------------------------
#  Conversions run in a child process that reads these unprefixed names only,
#  so give them without the CBOT_ prefix (none of them clash with another bot).

# [optional] Largest upload, in MB. Default: 2000, Telegram's own limit, when
# files over 20 MB can be fetched at all (TELEGRAM_API_ID above, or a local Bot
# API server), otherwise Telegram's 20. Lower it, never higher.
# CONVERT_MAX_FILE_MB=
# [optional] How many run at once, and how long a paid / free one may run.
# CONVERT_MAX_CONCURRENT=1
# CONVERT_TIME_LIMIT_SECONDS=600
# CONVERT_FREE_TIME_LIMIT_SECONDS=60
# CONVERT_MAX_QUEUED_PER_USER=5
# [optional] Albums: how many files, and how long to wait for the rest.
# CONVERT_MAX_BATCH=20
# CONVERT_BATCH_WAIT_SECONDS=2
# [optional] Ceilings that refuse a job before anything is charged.
# CONVERT_MAX_MEGAPIXELS=210
# CONVERT_MAX_PAGES=200
# CONVERT_MAX_FRAMES=1200
# CONVERT_MAX_ROWS=100000
# CONVERT_MAX_CELLS=2000000
# [optional] Archives: entries, expanded size in MB, and the most one ZIP entry may expand
# (times its packed size). CBOT_BSDTAR names the bsdtar program if it is not on PATH.
# CONVERT_MAX_ARCHIVE_ENTRIES=10000
# CONVERT_MAX_ARCHIVE_EXPANDED_MB=300
# CONVERT_MAX_ARCHIVE_RATIO=200
# CBOT_BSDTAR=
# [optional] Camera raw photos: the megapixels developed in full (past it, at half size),
# and the most that is taken at all. About 13 MB of memory a megapixel.
# CONVERT_RAW_FULL_MP=40
# CONVERT_RAW_MAX_MP=110
# [optional] Reading text from pictures and scanned PDFs (Tesseract inside PyMuPDF; the
# language data comes from the Dockerfile, TESSDATA_PREFIX). A page is drawn at the
# resolution that keeps it under OCR_MAX_PIXELS (300 dpi at most; ~17-19 MB a megapixel).
# Each scanned page gets OCR_PAGE_SECONDS on top of CONVERT_TIME_BASE_SECONDS, and the
# price is made from that limit. A PDF with more than OCR_MAX_PAGES scanned pages is not
# offered TXT or a searchable PDF; up to OCR_FREE_PAGES may be free when the file is under
# the free size. A page with fewer than OCR_MIN_TEXT_CHARS characters of its own is a
# picture of one; a page that would need under OCR_MIN_DPI is not read (a poster). A
# picture other than a JPEG over OCR_MAX_DECODE_PIXELS is refused before it is decoded.
# CONVERT_OCR_MAX_PIXELS=12000000
# CONVERT_OCR_PAGE_SECONDS=15
# CONVERT_OCR_MAX_PAGES=30
# CONVERT_OCR_FREE_PAGES=1
# CONVERT_OCR_MIN_TEXT_CHARS=20
# CONVERT_OCR_MIN_DPI=50
# CONVERT_OCR_MAX_DECODE_PIXELS=64000000
# [optional] A video over this many pixels is brought down to a 1920x1920 box when it is HDR,
# or going to WEBM (the memory a 4K one needs). 0 turns it off.
# CONVERT_VIDEO_FIT_PIXELS=2900000
# CONVERT_PAGE_DPI=150
# [optional] The largest one page may be when drawn as a picture, in megapixels: a page's
# size is written into the file, so a few hundred bytes can ask for a gigabyte.
# CONVERT_MAX_PAGE_MEGAPIXELS=100
# [optional] Where uploads wait, for how long, and the disk they may use.
# Defaults: the system temp folder; one person's share is the largest album
# plus 50 MB (at least 120); everybody's is at least 1024.
# CONVERT_UPLOAD_DIR=
# CONVERT_PENDING_TTL_SECONDS=900
# CONVERT_USER_STORAGE_MB=
# CONVERT_STORAGE_MB=
# CONVERT_MIN_FREE_MB=300
# [optional] Hard memory cap on a conversion, in MB; 0 leaves it to the host.
# CONVERT_WORKER_MAX_MEMORY_MB=0
# [optional] What the price is built on: sum (input + output) or max.
# CONVERT_BILLABLE=sum


# -----------------------------------------------------------------------------
#  DownloaderBot
# -----------------------------------------------------------------------------

# [optional] Allowance per person, per hour and per day (0 = no limit), and
# how much more a donor gets.
# DBOT_DOWNLOADS_PER_HOUR=12
# DBOT_DOWNLOADS_PER_DAY=40
# DBOT_DONOR_MULTIPLIER=4
# DBOT_DOWNLOAD_RETENTION_DAYS=7
# [optional] Size, length and concurrency ceilings.
# DBOT_MAX_DOWNLOAD_MB=48
# [optional] Large files, over DBOT_MAX_DOWNLOAD_MB: paid, off for each person
# until they switch it on in /settings, and only with TELEGRAM_API_ID above.
# The ceiling, never more than Telegram's 2000. The price follows the family's
# pricing rule (core/pricing.py; FAMILY_PRICE_* above tune it).
# DBOT_LARGE_MAX_MB=2000
# DBOT_MAX_DURATION_SECONDS=1800
# DBOT_MAX_CONCURRENT_DOWNLOADS=3
# DBOT_MAX_PER_USER=2
# DBOT_MAX_PENDING_PER_USER=5
# DBOT_MIN_FREE_MB=300
# [optional] The most files one post may deliver: every file is on disk before the first is
# sent, and a route is somebody else's server. The extra files are dropped (a TikTok
# slideshow carries up to 35 photos).
# DBOT_MAX_ITEMS_PER_POST=40
# [optional] The 📄 PDF and 🗜 ZIP buttons under an album: the most files one tap may fetch,
# and their total size in MB. A PDF page is refused over 20 megapixels.
# DBOT_MERGE_MAX_ITEMS=20
# DBOT_MERGE_MAX_MB=48
# [optional] The last download is kept this many seconds after its last use, so that the button under it and the
# same link sent again are answered without fetching the post twice; a different link deletes it at once.
# 0 turns it off (so does a value that is not a whole number, such as "off"). One delivery over
# DBOT_CACHE_ENTRY_MAX_MB is not kept; the whole cache stays under DBOT_CACHE_MAX_MB, least recently used
# out first. The cache gives way: kept files are deleted first whenever a download needs the space.
# DBOT_CACHE_SECONDS=300
# DBOT_CACHE_ENTRY_MAX_MB=100
# DBOT_CACHE_MAX_MB=400
# [optional] Posts already sent, sent again by Telegram file ID. The bot keeps the file IDs of what it has
# delivered, filed under a scrambled name of the post (a keyed hash of the link, made from the bot token: no
# new secret to set) and not under who asked: no user id, chat, username, link or caption is stored. A link
# for a post it has already sent is then answered without downloading it. A re-send still counts as a
# download in the allowance. A pasted duplicate of a link that is still downloading gets a reaction and no job.
# DBOT_SENT_FILES: 1 = on, 0 = off (no reads and no writes; so is a value that is not a whole number, such as "off").
# DBOT_FILEID_CONFIRM_HOURS: a stored reference is trusted this long after the post was last seen public (by a
# fetch, or by a lookup that still finds the post). An older one is sent only after a lookup shows the post still
# public; if the post is gone, or the lookup cannot tell, nothing old is sent and the bot goes to the platform as
# usual. The texts state 12 (and 90) as fixed numbers: change LEGAL.md and privacy_stored (en/uz/ru) first.
# Unreadable or under 1 = 12.
# DBOT_FILEID_KEEP_DAYS: a reference nobody has used for this many days is deleted by the routine housekeeping.
# The texts state 90 as a fixed number too. Unreadable or under 1 = 90.
# DBOT_SENT_FILES=1
# DBOT_FILEID_CONFIRM_HOURS=12
# DBOT_FILEID_KEEP_DAYS=90
# [optional] Where downloads are staged. Default: the system temp folder.
# DBOT_WORK_DIR=
# [optional] Timeouts.
# DBOT_SOCKET_TIMEOUT=30
# DBOT_CONNECT_TIMEOUT=10
# DBOT_READ_TIMEOUT=30
# [optional] The chain of download routes: per-route timeout, when a failing
# route is rested and for how long, and how often the scores are saved.
# DBOT_PROVIDER_TIMEOUT=20
# DBOT_PROBE_TIMEOUT=12
# [optional] yt-dlp downloads while it resolves, so it gets time for one: these seconds under
# the free ceiling, and this many more for every MB above it (large files). A route that runs
# out of time is stopped, and what it wrote is removed.
# DBOT_YTDLP_TIMEOUT=90
# DBOT_YTDLP_SECONDS_PER_MB=0.5
# [optional] Links to private and internal addresses are refused, on every redirect too. 1
# turns that off, for a media server of your own while developing -- never with real users.
# DBOT_ALLOW_PRIVATE_HOSTS=0
# [optional] The daily check that every platform still has a way in, and that yt-dlp is
# current. DBOT_YTDLP_AUTOUPDATE=1 lets the bot fetch a newer yt-dlp itself, once the
# release is DBOT_YTDLP_COOLDOWN_DAYS old; off by default.
# DBOT_ROUTEWATCH=1
# DBOT_ROUTEWATCH_FIRST_S=600
# DBOT_YTDLP_AUTOUPDATE=0
# DBOT_YTDLP_STALE_DAYS=14
# DBOT_YTDLP_COOLDOWN_DAYS=3
# DBOT_YTDLP_DIR=
# DBOT_PAGE_LIMIT_MB=8
# DBOT_PROVIDER_COOLDOWN_AFTER=3
# DBOT_PROVIDER_COOLDOWN_BASE=120
# DBOT_PROVIDER_COOLDOWN_MAX=3600
# DBOT_PROVIDER_FLUSH_SECONDS=60
# DBOT_INSTAFIX_HOST=https://eeinstagram.com
# DBOT_YT_PLAYER_CLIENTS=tv,web_safari,android_vr,web
# [optional] YouTube refuses a server's address, so behind yt-dlp are two kinds of relay that
# fetch from their own: public cobalt instances, then Invidious instances. They are hobby
# servers; one of your own goes FIRST (cobalt: with its key in DBOT_COBALT_API_KEY). A relay's
# file is fetched and checked inside the route, so DBOT_COBALT_TIMEOUT and
# DBOT_INVIDIOUS_TIMEOUT are for the whole route, file included; the INSTANCE ones are for one
# instance's answer. A file over the size limit is asked of cobalt again at 480p, then 360p.
# DBOT_INVIDIOUS_DIRECTORY is where more Invidious instances are found (0: only those named).
# DBOT_COBALT_INSTANCES=https://api.cobalt.liubquanti.click,https://cobaltapi.cjs.nz,https://dwnld.nichind.dev
# DBOT_COBALT_API_KEY=
# DBOT_COBALT_QUALITY=720
# DBOT_COBALT_INSTANCE_TIMEOUT=15
# DBOT_COBALT_TIMEOUT=240
# DBOT_INVIDIOUS_INSTANCES=https://yt.chocolatemoo53.com
# DBOT_INVIDIOUS_DIRECTORY=https://api.invidious.io/instances.json
# DBOT_INVIDIOUS_INSTANCE_TIMEOUT=15
# DBOT_INVIDIOUS_TIMEOUT=240
# [optional] Cookies as text, for a host with variables and no files: the whole cookies.txt.
# DBOT_COOKIES=
# DBOT_YT_COOKIES=
# DBOT_IG_COOKIES=
# DBOT_TT_COOKIES=
# DBOT_TW_COOKIES=
# DBOT_RD_COOKIES=
# [optional] Cookies and proxies, for sites that block a datacenter address.
# One for every site, or per site: IG Instagram, YT YouTube, TT TikTok,
# TW X/Twitter, RD Reddit. None by default; the two general ones as e.g.
# DBOT_COOKIES_FILE=/data/cookies.txt
# DBOT_IG_COOKIES_FILE=
# DBOT_YT_COOKIES_FILE=
# DBOT_TT_COOKIES_FILE=
# DBOT_TW_COOKIES_FILE=
# DBOT_RD_COOKIES_FILE=
# DBOT_PROXY=http://user:pass@host:port
# DBOT_IG_PROXY=
# DBOT_YT_PROXY=
# DBOT_TT_PROXY=
# DBOT_TW_PROXY=
# DBOT_RD_PROXY=


# -----------------------------------------------------------------------------
#  AnonBot
# -----------------------------------------------------------------------------

# [optional] Messages one person may send a minute, and the wait before the
# same person opens another conversation; 0 = off.
# ABOT_MSGS_PER_MINUTE=20
# ABOT_NEW_CONV_COOLDOWN_SEC=30
# [optional] Seconds the note about a reaction that could not be passed on
# stays up, and how often one person may be shown it.
# ABOT_REACTION_NOTE_SECONDS=8
# ABOT_REACTION_NOTE_EVERY_SECONDS=30
# [optional] Days an untouched conversation keeps its reply anchors, and the
# longest /export.
# RELAY_RETENTION_DAYS=180
# EXPORT_MAX_MESSAGES=500


# -----------------------------------------------------------------------------
#  ManagerBot
# -----------------------------------------------------------------------------

# [optional] When a bot counts as down, how long a remote command may take,
# and the start-up roll call.
# MBOT_DOWN_AFTER_SECONDS=120
# MBOT_COMMAND_TIMEOUT_SECONDS=90
# MBOT_REDEPLOY_GRACE_SECONDS=300
# MBOT_ROLLCALL_SECONDS=5
# MBOT_ROLLCALL_FRESH_SECONDS=120
# [optional] A daily summary at this UTC time, HH:MM. None by default. e.g.
# MBOT_DIGEST_UTC=09:00
# [optional] The nightly problem report: when (UTC) and how far back.
# 13:00 UTC is 22:00 in Korea.
# MBOT_NIGHTLY_UTC=13:00
# MBOT_NIGHTLY_HOURS=24
# [optional] How often results and events are collected.
# MBOT_RESULT_POLL_SECONDS=20
# MBOT_RESULT_POLL_FAST_SECONDS=1
# MBOT_EVENT_POLL_SECONDS=30
# MBOT_EVENT_POLL_FAST_SECONDS=2
# MBOT_PUMP_TICK_SECONDS=1
# [optional] /backup's largest file, in MB.
# MBOT_BACKUP_PART_MB=49
# [optional] /usage and /idle: the memory price, the report window, and the
# assumed cold start.
# MEMORY_USD_PER_MB_MONTH=0.01
# USAGE_REPORT_HOURS=24
# COLD_START_SECONDS=6
# [optional] The bots ManagerBot watches, id:Name:schema. Only for adding or
# renaming a bot.
# FAMILY_REGISTRY=stickerbot:StickerBot:sticker_bot,convertbot:ConvertBot:convert_bot,downloaderbot:DownloaderBot:downloader_bot,anonbot:AnonBot:anon_bot
# [optional] Only for bots/manager_bot/family_db.py when it copies data
# between two databases: the other one.
# CLOUD_DATABASE_URL=


# -----------------------------------------------------------------------------
#  Not settings
# -----------------------------------------------------------------------------
#  Read by the code but not set here: DB_SCHEMA (each bot's folder name),
