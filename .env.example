# Copy to .env for local runs. On Railway, set these as service variables instead.
# Values in <angle brackets> must be replaced: main.py refuses to start while any are left.
#
# Any setting can be given to one bot only by prefixing it with that bot's prefix:
# SBOT_ (sticker), CBOT_ (convert), DBOT_ (downloader), ABOT_ (anon), MBOT_ (manager).
# e.g. CBOT_FFMPEG_THREADS=4 applies to ConvertBot alone.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Supabase: Project Settings -> Database -> Session pooler (port 5432).
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
# Numeric Telegram user id(s) of the operator, comma-separated (@userinfobot shows yours).
ADMIN_ID=<your-telegram-user-id>

# ── Bots: a bot without a token is skipped ──────────────────────────────────
SBOT_TOKEN=<token-from-BotFather>
SBOT_USERNAME=<sticker-bot-username>

CBOT_TOKEN=<token-from-BotFather>
CBOT_USERNAME=<convert-bot-username>

DBOT_TOKEN=<token-from-BotFather>
DBOT_USERNAME=<downloader-bot-username>

ABOT_TOKEN=<token-from-BotFather>
ABOT_USERNAME=<anon-bot-username>

MBOT_TOKEN=<token-from-BotFather>
MBOT_USERNAME=<manager-bot-username>

# ── Optional ────────────────────────────────────────────────────────────────
# MTProto (my.telegram.org): lets Convert/Downloader handle files up to 2000 MB instead of 50 MB.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# The data key that seals personal data (docs/data-key-options.md). Either a sealed variable...
# DATA_KEY=
# ...or a file on a volume (default /run/secrets/mumu_data_key).
# DATA_KEY_FILE=

# Which bots this process runs (default: all with a token): sticker, convert, downloader, anon, manager.
# BOTS=sticker,anon
# How they are split into processes: one (default), separate, or groups like "manager;convert".
# MUMU_PROCESSES=one

# Where users and the operator are pointed for terms, privacy and contact.
# Defaults to this repository's LEGAL.md; a fork that runs its own bots should point at its own.
# LEGAL_URL=https://github.com/<you>/<repo>/blob/main/LEGAL.md
# OPERATOR_CONTACT=<email>
# FAMILY_REPORTS_TO=<telegram-user-id-for-reports>

# Logging and process tuning
# LOG_TO_FILES=0
# UNIFIED_STATUS_MINUTES=30
# UNIFIED_DRAIN_SECONDS=30
# WORKER_THREADS_PER_BOT=16
# GC_GEN0_THRESHOLD=5000

# Payments (Telegram Stars; fiat only with a provider token)
# FIAT_DONATIONS=off
# SBOT_PAYMENT_PROVIDER_TOKEN_USD=
# FAMILY_TOPUP_MULTIPLIER=2
# FAMILY_TOPUP_LADDER=500:3,500:2
# FAMILY_BONUS_EXPIRY_DAYS=90

# Problem reports and usage alarms
# PROBLEM_FLUSH_SECONDS=20
# PROBLEM_ALERT_COOLDOWN_SECONDS=900
# PROBLEM_RETENTION_DAYS=180
# FEEDBACK_RETENTION_DAYS=30
# FEEDBACK_PER_DAY=5
# USAGE_SAMPLE_MINUTES=15
# USAGE_MEMORY_WARN_RATIO=0.85

# Flood control (0 = off; the operator is always exempt)
# FLOOD_UPDATES_PER_MINUTE=40
# FLOOD_REMIND_SECONDS=60

# Database pool
# DB_POOL_MIN=1
# DB_POOL_MAX=3
# DB_POOL_TIMEOUT=15

# Safe redeploys: the old and new copy hand over in-flight work through the database.
# DEPLOY_SAFETY=on
# DEPLOY_LEASE_WAIT_SECONDS=240

# StickerBot / video encoding
# STICKER_ENCODE_ATTEMPTS=4
# FFMPEG_THREADS=2
# FFMPEG_TIMEOUT_SECONDS=600

# ConvertBot limits
# CONVERT_MAX_CONCURRENT=1
# CONVERT_TIME_LIMIT_SECONDS=600
# CONVERT_FREE_TIME_LIMIT_SECONDS=60
# CONVERT_MAX_BATCH=20
# CONVERT_MAX_PAGES=200
# CONVERT_MIN_FREE_MB=300

# DownloaderBot limits, cookies and proxies (per platform: see bots/downloader_bot/video.py)
# DBOT_DOWNLOADS_PER_HOUR=12
# DBOT_DOWNLOADS_PER_DAY=40
# DBOT_MAX_DOWNLOAD_MB=48
# DBOT_MAX_DURATION_SECONDS=1800
# DBOT_COOKIES_FILE=
# DBOT_PROXY=

# AnonBot
# ABOT_MSGS_PER_MINUTE=20
# ABOT_NEW_CONV_COOLDOWN_SEC=30
# RELAY_RETENTION_DAYS=180

# ManagerBot schedules (UTC)
# MBOT_DIGEST_UTC=09:00
# MBOT_NIGHTLY_UTC=13:00
