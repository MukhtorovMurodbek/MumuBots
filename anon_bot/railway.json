{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "anon_bot/Dockerfile",
    "watchPatterns": [
      "/anon_bot/**",
      "/shared/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "sleepApplication": false,
    "overlapSeconds": 30,
    "drainingSeconds": 120
  }
}
