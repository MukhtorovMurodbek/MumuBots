# TestBot — the one file you edit.
#
# 1. Copy this file to `token.env` in the same folder (keep the name exactly).
# 2. Paste your test bot's token after the `=` on the TESTBOT_TOKEN line.
#    Nothing else in here has to change.
# 3. From the repo root:  .\testbot\run.ps1 sticker
#
# `token.env` is gitignored and never published. This example file is the
# only one that is tracked, and it must never contain a real token.


# ---------------------------------------------------------------------------
# THE TOKEN. Paste it here, after the "=", with no quotes and no spaces.
# ---------------------------------------------------------------------------
# Where to get it: open @BotFather in Telegram, send /mybots, choose
# @Personal_Sticker_Creator_bot, then "API Token". It looks like
# 8123456789:AAH0pQ7-abcdefGHIJklmnOPqrstUVwxyz0
#
# If the token has ever been pasted into a chat, a screenshot or a commit,
# use @BotFather's "Revoke current token" first and paste the new one.

TESTBOT_TOKEN=


# ---------------------------------------------------------------------------
# The username, without the @. Only used to build the links the bot hands out
# (AnonBot's inbox links, DownloaderBot's help text), so it has to match the
# token above or those links will point at the wrong bot.
# ---------------------------------------------------------------------------
TESTBOT_USERNAME=Personal_Sticker_Creator_bot


# ---------------------------------------------------------------------------
# Your own Telegram numeric id, so the owner-only commands answer you.
# Get it by sending /me to ManagerBot, or /start to @userinfobot.
# ---------------------------------------------------------------------------
TESTBOT_ADMIN_ID=


# ---------------------------------------------------------------------------
# Everything below has a working default. Change it only if you mean to.
# ---------------------------------------------------------------------------

# The database TestBot uses: the local one from docker-compose.yml, as here,
# or the shared one the real bots use (a hosted TestBot can reach no other).
# Either way its tables are testbot_<bot> and it runs under its own names --
# testbot/README.md, "Either database". Set TESTBOT_DATABASE_URL in the shell
# to use the other one for a single run without editing this file.
TESTBOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/botfamily

# What it calls itself on the family bus. Both of these are overrides read by
# family_link.attach(), and they are what stop a test run writing its
# heartbeat under the real bot's name.
FAMILY_LABEL=TestBot
FAMILY_BOT_ID=testbot

# The sibling-bot cross-promotion row under /start. Left empty so TestBot
# never advertises the real bots — a tester tapping through to production is
# how a test message ends up in a real inbox.
SIBLING_BOTS=

# Optional: ConvertBot's route for files over 20 MB (my.telegram.org -> API
# development tools). Read from convert_bot/.env when they are not set here.
# CBOT_API_ID=
# CBOT_API_HASH=
